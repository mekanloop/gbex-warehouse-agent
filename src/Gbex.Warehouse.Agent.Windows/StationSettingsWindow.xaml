<Window x:Class="Gbex.Warehouse.Agent.Windows.StationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İstasyon Ayarları" Height="760" Width="620" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}" FontFamily="Segoe UI">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource NavyBrush}" Padding="24,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="İstasyon Ayarları" FontSize="16" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="GBEX ve EasyCube bağlantı yapılandırması" FontSize="11" Foreground="#B9AEDD" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18,24,18">

                <Border Style="{StaticResource AccentCardOuter}" Background="#EAF7EE" BorderBrush="#BEE5C8" Margin="0,0,0,16" Padding="12,10"
                        x:Name="WelcomeBanner" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👋" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="WelcomeText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                                   Text="Kuruluma hoş geldiniz. Devam etmek için aşağıdaki bilgileri girip 'Kaydet' butonuna basın." />
                    </StackPanel>
                </Border>

                <!-- GBEX server -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="🌐" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="GBEX Sunucu Adresi" Style="{StaticResource FieldLabelText}" />
                        </StackPanel>
                        <TextBlock Text="Örnek: https://app.gbex.com.tr" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GbexBaseUrlBox" Grid.Column="0" Style="{StaticResource ModernTextBox}" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="Bağlantıyı Test Et" Style="{StaticResource SecondaryButton}" Click="TestGbexConnection_Click" />
                        </Grid>
                        <TextBlock x:Name="GbexTestResultText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- Station secret -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="🔑" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Tek Kullanımlık İstasyon Anahtarı" Style="{StaticResource FieldLabelText}" />
                        </StackPanel>
                        <TextBlock x:Name="SecretStatusText" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="GBEX yöneticinizden aldığınız anahtarı buraya yapıştırın. Kaydettikten sonra bir daha görüntülenmez."
                                   Style="{StaticResource CaptionText}" Margin="0,2,0,6" />
                        <PasswordBox x:Name="StationSecretBox" Style="{StaticResource ModernPasswordBox}" />
                    </StackPanel>
                </Border>

                <!-- EasyCube TCP -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="🔌" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="EasyCube IP Adresi ve TCP Portu (Ana Bağlantı)" Style="{StaticResource FieldLabelText}" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,0,0,6"
                                   Text="Barkod okuyucu EasyCube cihazına, EasyCube ise Ethernet kablosuyla aynı ağ anahtarına (switch) bağlıdır. Buraya EasyCube'un ağ üzerindeki IP adresini ve TCP portunu girin — örnek: 192.168.1.50 / 9990." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="EasyCubeTcpHostBox" Grid.Column="0" Style="{StaticResource ModernTextBox}" Margin="0,0,8,0" />
                            <TextBox x:Name="EasyCubeTcpPortBox" Grid.Column="1" Style="{StaticResource ModernTextBox}" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="Bağlantıyı Test Et" Style="{StaticResource SecondaryButton}" Click="TestEasyCubeTcpConnection_Click" />
                        </Grid>
                        <TextBlock x:Name="EasyCubeTcpTestResultText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- EasyCube HTTP fallback -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="📷" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="EasyCube HTTP Adresi (Yedek Bağlantı ve Uyuşmazlık Fotoğrafı)" Style="{StaticResource FieldLabelText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,0,0,6"
                                   Text="Barkod okuyucu PC'ye takılıysa elle barkod girişi için, HER İKİ DURUMDA da bir uyumsuzluk tespit edildiğinde EasyCube'un çektiği fotoğrafı almak için kullanılır. Doldurulmazsa uyumsuzluk anında fotoğraf gönderilmez, ölçüm yine de kaydedilir. Örnek: http://192.168.1.50:8080" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="EasyCubeBaseUrlBox" Grid.Column="0" Style="{StaticResource ModernTextBox}" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="Bağlantıyı Test Et" Style="{StaticResource SecondaryButton}" Click="TestEasyCubeConnection_Click" />
                        </Grid>
                        <TextBlock x:Name="EasyCubeTestResultText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- Device identity -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🏷️" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Cihaz Kimliği (opsiyonel)" Style="{StaticResource FieldLabelText}" />
                        </StackPanel>
                        <TextBox x:Name="DeviceIdBox" Style="{StaticResource ModernTextBox}" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                    <Button Content="Kimlik Bilgisini Kaldır" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="RemoveCredential_Click" />
                    <Button Content="Kaydet" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Save_Click" />
                    <Button Content="Kapat" Style="{StaticResource SecondaryButton}" Click="Close_Click" />
                </StackPanel>

                <TextBlock x:Name="ResultText" Margin="0,12,0,0" TextWrapping="Wrap" FontWeight="Bold" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
