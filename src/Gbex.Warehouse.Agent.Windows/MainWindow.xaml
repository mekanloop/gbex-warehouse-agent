<Window x:Class="Gbex.Warehouse.Agent.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GBEX Depo Ajanı" Height="600" Width="800" MinHeight="560" MinWidth="740"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== Header ===================== -->
        <Border Grid.Row="0" Background="{StaticResource NavyBrush}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource YellowBrush}" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="G" FontSize="18" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GBEX Depo Ajanı" FontSize="18" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Windows Warehouse Agent" FontSize="11" Foreground="#B9AEDD" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#2E1A5C" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource YellowBrush}" FontSize="11" FontWeight="SemiBold">
                        <Run Text="v" /><Run Text="{Binding AgentVersion, Mode=OneWay}" />
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== Body ===================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,20">

                <!-- Update banner — only visible while a verified update is staged. -->
                <Border Style="{StaticResource AccentCardOuter}" Background="{StaticResource WarningBackgroundBrush}"
                        BorderBrush="#F2C572" Margin="0,0,0,16" Padding="14,10"
                        Visibility="{Binding HasPendingUpdate, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔔" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding UpdateBannerText}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480" />
                        <Button Content="Şimdi Güncelle" Style="{StaticResource AccentButton}" Margin="16,0,0,0"
                                VerticalAlignment="Center" Click="InstallUpdate_Click" />
                    </StackPanel>
                </Border>

                <!-- Status tiles -->
                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🔗" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock Text="GBEX Bağlantısı" Style="{StaticResource CardTitleText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding StationStatusText}" Style="{StaticResource CardValueText}" FontSize="14" />
                            <TextBlock Text="{Binding LastHeartbeatAt, StringFormat='Son nabız: {0:HH:mm:ss}'}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="6,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="📷" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock Text="EasyCube Cihazı" Style="{StaticResource CardTitleText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding EasyCubeStatusText}" Style="{StaticResource CardValueText}" FontSize="14" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="6,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="⚙️" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock Text="İş Akışı Durumu" Style="{StaticResource CardTitleText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding WorkflowStatusText}" Style="{StaticResource CardValueText}" FontSize="14" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="📦" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock Text="Çevrimdışı Kuyruk" Style="{StaticResource CardTitleText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding OfflineQueueCount}" Style="{StaticResource CardValueText}" FontSize="22" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Manual scan fallback -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Normal kullanımda hiçbir şey yapmanız gerekmez — EasyCube'un okuttuğu barkod ve ölçüm otomatik işlenir."
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Yedek — barkodu elle gir:" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Style="{StaticResource FieldLabelText}" />
                            <TextBox x:Name="ScanTextBox" Width="260" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding ScanInput, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="ScanTextBox_KeyDown" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Declared vs. last result -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Beyan Edilen" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding FulfillmentModeText}" FontWeight="Bold"
                                       Foreground="{StaticResource WarningBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CurrentOrder.DeclaredWeight, StringFormat='Ağırlık: {0} kg'}" Style="{StaticResource CardValueText}" FontSize="13" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding CurrentOrder.DeclaredLength, StringFormat='Uzunluk: {0} cm'}" Style="{StaticResource CardValueText}" FontSize="13" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding CurrentOrder.DeclaredWidth, StringFormat='Genişlik: {0} cm'}" Style="{StaticResource CardValueText}" FontSize="13" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding CurrentOrder.DeclaredHeight, StringFormat='Yükseklik: {0} cm'}" Style="{StaticResource CardValueText}" FontSize="13" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Son Ölçüm Sonucu" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding LastMeasurementSummary}" Style="{StaticResource CardValueText}" FontSize="13" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,0,0,16"
                           Text="Barkod okuyucu EasyCube cihazına takılıdır; paket EasyCube'dan geçtiğinde barkod ve ölçüm otomatik gönderilir. Fiyatlandırma, onay, cüzdan ve gönderi değişimi işlemleri web yönetim panelinde yapılır." />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Tanılama Raporunu Dışa Aktar" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="ExportDiagnostics_Click" />
                    <Button Content="İstasyon Ayarları" Style="{StaticResource PrimaryButton}" Click="StationSettings_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
